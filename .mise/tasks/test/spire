docker stop kmip-go-kms-spire 2>/dev/null || true
sleep 2
S2_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 3 \
  --cacert "${CERTS_DIR}/ca.crt" \
  --cert   "${CERTS_DIR}/spire-client.crt" \
  --key    "${CERTS_DIR}/spire-client.key" \
  -X POST "${KMS_URL}/kmip/2_1" -H "Content-Type: application/json" \
  -d '{"tag":"Locate","value":[]}' 2>/dev/null || echo "000")
if [[ "${S2_CODE}" == "000" || "${S2_CODE}" =~ ^5[0-9][0-9]$ ]]; then
  print_success "Scenario 2-equiv: KMS down yields connection failure (${S2_CODE}) — SPIRE errors cleanly."
else
  print_info "Scenario 2-equiv: got HTTP ${S2_CODE} (expected connection failure)."
fi

# Restart KMS and confirm recovery
docker start kmip-go-kms-spire 2>/dev/null || docker run -d --name kmip-go-kms-spire -p 9998:9998 -p 5696:5696 -v "${CERTS_DIR}/kms.crt:/etc/kms/certs/kms.crt:ro" -v "${CERTS_DIR}/kms.key:/etc/kms/certs/kms.key:ro" -v "${CERTS_DIR}/ca.crt:/etc/kms/certs/ca.crt:ro" -v "${_KMS_TMP_DIR}/kms.toml:/etc/kms/kms.toml:ro" "ghcr.io/cosmian/kms:${KMS_IMAGE_TAG:-5.26.0}" --config /etc/kms/kms.toml
TRIES=0
until "${CURL_MTLS[@]}" "${KMS_URL}/version" >/dev/null 2>&1; do
  TRIES=$((TRIES+1)); [[ "${TRIES}" -ge 30 ]] && print_error "KMS did not recover in 30s."; sleep 1
done
