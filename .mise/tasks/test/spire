# ── Step 11: SPIRE server log gate ────────────────────────────────────────────
print_status "Step 11: SPIRE server log gate"
LOG_GATE_FAILED=0
for t in "${TENANTS[@]}"; do
  log="/tmp/spire-server-${t}.log"
  total=$(wc -l <"${log}" | tr -d ' ')
  print_info "spire-server-${t}: ${total} log lines."

  warn_count=$(grep -c -E 'level=warn|level=warning|WARN' "${log}" || true)
  [[ "${warn_count}" -gt 0 ]] && print_info "  ${warn_count} warning(s) (non-fatal)."

  if error_lines=$(grep -n -E 'level=error|level=fatal|[[:space:]]ERROR|[[:space:]]FATA' "${log}" 2>/dev/null); then
    print_info "spire-server-${t}: ERROR/FATAL lines:"
    echo "${error_lines}"
    LOG_GATE_FAILED=1
  else
    print_success "spire-server-${t}: no error/fatal log lines."
