#!/usr/bin/env bash
#MISE description="SPIRE + Mistral client full integration tests — kmip KMIP 2.1 plugins (replaces KMS repo test:spire)"
#USAGE flag "-t --tag <tag>" env="KMS_IMAGE_TAG" help="cosmian/kms Docker image tag" default="5.26.0"
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
KMS_IMAGE_TAG="${KMS_IMAGE_TAG:-5.26.0}"
TEST_DATA="${REPO_ROOT}/test_data/spire"
SPIRE_DIR="${REPO_ROOT}/spire"
CERTS_DIR="${TEST_DATA}/certs"
GO=$(command -v go)
SPIRE_SERVER_BIN="${SPIRE_DIR}/bin/spire-server-kmip-e2e"
CA_KEY_UID="spire-kmip-root-ca-key"

# ── Multi-tenant topology (bit-to-bit with KMS repo test:spire) ───────────────
# Two INDEPENDENT SPIRE deployments (tenants "a" and "b") run against the SAME
# KMS, each with its own trust domain, server-id, agent, and 2 Mistral workloads.
TENANTS=("a" "b")
tenant_trust_domain() { echo "cosmian-test-$1.local"; }
tenant_server_id()    { echo "spire-kmip-tenant-$1"; }
tenant_server_port()  { [[ "$1" == "a" ]] && echo 8081 || echo 8082; }

_TMP_DIR=""
declare -A SPIRE_SERVER_PIDS=()
SPIRE_LOGS=()

# ── Helpers ──────────────────────────────────────────────────────────────────
require_cmd() { command -v "$1" >/dev/null 2>&1 || { echo "[ERROR] '$1' not found."; exit 1; }; }
print_header() { echo ""; echo "════════════════════════════════════════════"; echo "  $1"; echo "════════════════════════════════════════════"; echo ""; }
print_status() { echo ""; echo "[STEP] $1"; }
print_info()   { echo "   [i] $1"; }
print_success(){ echo "   [✓] $1"; }
print_error()  { echo "   [✗] $1" >&2; exit 1; }
print_warning(){ echo "   [!] $1"; }

wait_server_healthy() {
  local t="$1" socket="/tmp/spire-server-${t}/private/api.sock" tries=0
  until "${SPIRE_SERVER_BIN}" healthcheck -socketPath "${socket}" 2>/dev/null; do
    tries=$((tries + 1))
    if [[ "${tries}" -ge 40 ]]; then
      tail -20 "/tmp/spire-server-${t}.log" || true
      print_error "SPIRE server '${t}' did not become healthy after 40 attempts."
    fi
    sleep 3
  done
}

wait_agent_ready_docker() {
  local t="$1" tries=0
  until docker exec "spire-agent-${t}" /opt/spire/bin/spire-agent healthcheck \
    -socketPath /tmp/spire-agent/public/api.sock 2>/dev/null; do
    tries=$((tries + 1))
    if [[ "${tries}" -ge 24 ]]; then
      docker logs "spire-agent-${t}" 2>&1 | tail -20 || true
      print_error "SPIRE agent '${t}' workload API socket did not appear in time."
    fi
    sleep 5
  done
}

# ── Port helpers (mirrors KMS test:spire) ─────────────────────────────────────
listener_pids_for_port() { lsof -ti tcp:"$1" 2>/dev/null | sort -u || true; }
port_is_listening()      { lsof -i tcp:"$1" -sTCP:LISTEN 2>/dev/null | grep -q . 2>/dev/null; }

stop_listener_on_port() {
  local port="$1" label="$2" pids
  pids="$(listener_pids_for_port "${port}")"
  [[ -z "${pids}" ]] && return 0
  print_info "Stopping stale ${label} on port ${port}…"
  while IFS= read -r pid; do [[ -n "${pid}" ]] && kill "${pid}" 2>/dev/null || true; done <<<"${pids}"
  sleep 2
}

# ── Cleanup + reset ───────────────────────────────────────────────────────────
reset_state() {
  stop_listener_on_port 9998 "KMS"
  stop_listener_on_port 8081 "SPIRE server-a"
  stop_listener_on_port 8082 "SPIRE server-b"

  # Remove named containers from previous runs (by known container_name values)
  docker rm -f spire-agent-a spire-agent-b \
    mistral-agent-a1 mistral-agent-a2 mistral-agent-b1 \
    spire-kmip-kms spire-kmip-server-a spire-kmip-server-b 2>/dev/null || true

  if [[ -n "${_TMP_DIR:-}" && -f "${_TMP_DIR}/dc.yml" ]]; then
    docker compose -f "${_TMP_DIR}/dc.yml" --profile spire-kmip down \
      --volumes --remove-orphans 2>/dev/null || true
  fi
  docker stop kmip-go-kms-spire 2>/dev/null || true; docker rm -f kmip-go-kms-spire 2>/dev/null || true
  [[ -n "${_KMS_TMP_DIR:-}" ]] && rm -rf "${_KMS_TMP_DIR}" 2>/dev/null || true

  rm -rf /tmp/spire-server-* /tmp/spire-agent-config-* 2>/dev/null || true
  rm -f  /tmp/spire-server-*.log 2>/dev/null || true
}

cleanup() {
  print_info "Cleaning up SPIRE kmip integration test resources…"
  for t in "${TENANTS[@]}"; do
    local log="/tmp/spire-server-${t}.log"
    [[ -f "${log}" ]] && { echo "--- SPIRE SERVER '${t}' LOGS (last 30 lines) ---"; tail -30 "${log}" || true; }
    for svc in "spire-agent-${t}"; do
      docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${svc}$" && \
        { echo "--- ${svc^^} LOGS ---"; docker logs "${svc}" 2>&1 | tail -30 || true; } || true
    done
    [[ -n "${SPIRE_SERVER_PIDS[$t]:-}" ]] && kill "${SPIRE_SERVER_PIDS[$t]}" 2>/dev/null || true
    wait "${SPIRE_SERVER_PIDS[$t]:-0}" 2>/dev/null || true
  done
  reset_state
  [[ -n "${_TMP_DIR:-}" ]] && rm -rf "${_TMP_DIR}" 2>/dev/null || true
}
trap cleanup EXIT

require_cmd docker; require_cmd go; require_cmd python3; require_cmd openssl

if [[ ! -d "${TEST_DATA}" ]]; then
  print_error "test_data/spire not found. Run: git submodule update --init test_data"
fi

print_status "Resetting state from any previous run…"
reset_state

print_header "SPIRE + Mistral Client — kmip native KMIP 2.1 plugins"

# ── Step 1: TLS certificates ──────────────────────────────────────────────────
print_status "Step 1: TLS certificates"
if [[ ! -f "${CERTS_DIR}/spire-client.crt" ]]; then
  print_info "Generating test TLS certificates (including mTLS client cert)…"
  bash "${CERTS_DIR}/generate-test-certs.sh"
else
  print_info "TLS certificates already present."
fi

# ── Step 2: Build spire-server from submodule ─────────────────────────────────
print_status "Step 2: Build spire-server (feature/kmip-plugins)"
mkdir -p "${SPIRE_DIR}/bin"
(cd "${SPIRE_DIR}" && "${GO}" build -o "${SPIRE_SERVER_BIN}" ./cmd/spire-server/) || \
  print_error "Failed to build spire-server. Is the submodule checked out?"
print_success "spire-server built: ${SPIRE_SERVER_BIN}"

# ── Step 3: Start KMS (mTLS HTTPS + binary KMIP TCP socket) ───────────────────
print_status "Step 3: Start KMS with mTLS + socket server (ghcr.io/cosmian/kms:${KMS_IMAGE_TAG:-5.26.0})"
# Write a temp KMS config with socket server enabled.
_KMS_TMP_DIR=$(mktemp -d /tmp/spire-kms-XXXXXX)
cat >"${_KMS_TMP_DIR}/kms.toml" <<TOML
default_username = "admin"

[db]
database_type  = "sqlite"
sqlite_path    = "/tmp/kms"
clear_database = true

[http]
hostname = "0.0.0.0"
port     = 9998

[tls]
tls_cert_file        = "/etc/kms/certs/kms.crt"
tls_key_file         = "/etc/kms/certs/kms.key"
clients_ca_cert_file = "/etc/kms/certs/ca.crt"

[socket_server]
socket_server_start    = true
socket_server_port     = 5696
socket_server_hostname = "0.0.0.0"

[logging]
rust_log    = "warn"
ansi_colors = false
TOML
docker run -d --name kmip-go-kms-spire \
  -p 9998:9998 -p 5696:5696 \
  -v "${CERTS_DIR}/kms.crt:/etc/kms/certs/kms.crt:ro" \
  -v "${CERTS_DIR}/kms.key:/etc/kms/certs/kms.key:ro" \
  -v "${CERTS_DIR}/ca.crt:/etc/kms/certs/ca.crt:ro" \
  -v "${_KMS_TMP_DIR}/kms.toml:/etc/kms/kms.toml:ro" \
  "ghcr.io/cosmian/kms:${KMS_IMAGE_TAG:-5.26.0}" --config /etc/kms/kms.toml

KMS_URL="https://127.0.0.1:9998"
CURL_MTLS=(curl -sf \
  --cacert "${CERTS_DIR}/ca.crt" \
  --cert   "${CERTS_DIR}/spire-client.crt" \
  --key    "${CERTS_DIR}/spire-client.key")
# Same as CURL_MTLS but without -f: use for adversarial tests expecting 4xx/5xx responses
CURL_MTLS_NOCHECK=(curl -s \
  --cacert "${CERTS_DIR}/ca.crt" \
  --cert   "${CERTS_DIR}/spire-client.crt" \
  --key    "${CERTS_DIR}/spire-client.key")

print_info "Waiting for KMS (mTLS) at ${KMS_URL}…"
TRIES=0
until "${CURL_MTLS[@]}" "${KMS_URL}/version" >/dev/null 2>&1; do
  TRIES=$((TRIES + 1))
  [[ "${TRIES}" -ge 60 ]] && { docker logs kmip-go-kms-spire 2>&1 | tail -10; print_error "KMS did not start in 60s"; }
  sleep 1
done
print_success "KMS (mTLS) ready at ${KMS_URL}"
TRIES=0
until nc -z 127.0.0.1 5696 2>/dev/null; do
  TRIES=$((TRIES + 1)); [[ "${TRIES}" -ge 30 ]] && print_error "KMS binary KMIP TCP did not open"
  sleep 1
done
print_success "Binary KMIP TCP socket ready at 127.0.0.1:5696"

# ── Step 4: Provision root CA key pair + self-signed cert ─────────────────────
print_status "Step 4: Provision root CA key pair + self-signed certificate"
CA_EXT_HEX=$(printf '[v3_ca]\nbasicConstraints=critical,CA:TRUE\nkeyUsage=critical,keyCertSign,crlSign,digitalSignature\n' \
  | xxd -p | tr -d '\n' | tr '[:lower:]' '[:upper:]')

"${CURL_MTLS[@]}" -X POST "${KMS_URL}/kmip/2_1" -H "Content-Type: application/json" \
  -d "{\"tag\":\"CreateKeyPair\",\"value\":[{\"tag\":\"CommonAttributes\",\"value\":[{\"tag\":\"CryptographicAlgorithm\",\"type\":\"Enumeration\",\"value\":\"EC\"},{\"tag\":\"CryptographicDomainParameters\",\"value\":[{\"tag\":\"RecommendedCurve\",\"type\":\"Enumeration\",\"value\":\"P384\"}]},{\"tag\":\"KeyFormatType\",\"type\":\"Enumeration\",\"value\":\"ECPrivateKey\"},{\"tag\":\"ActivationDate\",\"type\":\"DateTime\",\"value\":\"2024-01-01T00:00:00Z\"}]},{\"tag\":\"PrivateKeyAttributes\",\"value\":[{\"tag\":\"UniqueIdentifier\",\"type\":\"TextString\",\"value\":\"${CA_KEY_UID}\"},{\"tag\":\"CryptographicUsageMask\",\"type\":\"Integer\",\"value\":1063425}]},{\"tag\":\"PublicKeyAttributes\",\"value\":[{\"tag\":\"CryptographicUsageMask\",\"type\":\"Integer\",\"value\":1051138}]}]}" >/dev/null

"${CURL_MTLS[@]}" -X POST "${KMS_URL}/kmip/2_1" -H "Content-Type: application/json" \
  -d "{\"tag\":\"Certify\",\"value\":[{\"tag\":\"UniqueIdentifier\",\"type\":\"TextString\",\"value\":\"${CA_KEY_UID}_pk\"},{\"tag\":\"Attributes\",\"value\":[{\"tag\":\"CertificateType\",\"type\":\"Enumeration\",\"value\":\"X509\"},{\"tag\":\"CertificateAttributes\",\"value\":[{\"tag\":\"CertificateSubjectCn\",\"type\":\"TextString\",\"value\":\"SPIRE KMIP Root CA\"},{\"tag\":\"CertificateSubjectO\",\"type\":\"TextString\",\"value\":\"SPIFFE\"},{\"tag\":\"CertificateSubjectOu\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateSubjectEmail\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateSubjectC\",\"type\":\"TextString\",\"value\":\"US\"},{\"tag\":\"CertificateSubjectSt\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateSubjectL\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateSubjectUid\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateSubjectSerialNumber\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateSubjectTitle\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateSubjectDc\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateSubjectDnQualifier\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerCn\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerO\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerOu\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerEmail\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerC\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerSt\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerL\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerUid\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerSerialNumber\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerTitle\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerDc\",\"type\":\"TextString\",\"value\":\"\"},{\"tag\":\"CertificateIssuerDnQualifier\",\"type\":\"TextString\",\"value\":\"\"}]},{\"tag\":\"Attribute\",\"value\":[{\"tag\":\"VendorIdentification\",\"type\":\"TextString\",\"value\":\"cosmian\"},{\"tag\":\"AttributeName\",\"type\":\"TextString\",\"value\":\"x509-extension\"},{\"tag\":\"AttributeValue\",\"type\":\"ByteString\",\"value\":\"${CA_EXT_HEX}\"}]}]}]}" >/dev/null

print_success "Root CA key (uid=${CA_KEY_UID}) and self-signed cert provisioned."

# ── Step 5: Pre-flight — KMIP API conformance (replaces Vault API conformance) ─
print_status "Step 5: KMIP API conformance pre-flight"

# 5a: Tenant-A can create a key pair via KMIP
PRE_KP=$("${CURL_MTLS[@]}" -X POST "${KMS_URL}/kmip/2_1" -H "Content-Type: application/json" \
  -d '{"tag":"CreateKeyPair","value":[{"tag":"CommonAttributes","value":[{"tag":"CryptographicAlgorithm","type":"Enumeration","value":"EC"},{"tag":"CryptographicDomainParameters","value":[{"tag":"RecommendedCurve","type":"Enumeration","value":"P256"}]},{"tag":"KeyFormatType","type":"Enumeration","value":"ECPrivateKey"},{"tag":"ActivationDate","type":"DateTime","value":"2024-01-01T00:00:00Z"}]},{"tag":"PrivateKeyAttributes","value":[{"tag":"CryptographicUsageMask","type":"Integer","value":1063425}]},{"tag":"PublicKeyAttributes","value":[{"tag":"CryptographicUsageMask","type":"Integer","value":1051138}]}]}')
PRE_UID=$(echo "${PRE_KP}" | python3 -c "import sys,json; v=json.load(sys.stdin)['value']; print([x['value'] for x in v if x['tag']=='PrivateKeyUniqueIdentifier'][0])")
if [[ -n "${PRE_UID}" ]]; then
  print_success "5a: KMIP CreateKeyPair → uid=${PRE_UID}"
  # Cleanup: Revoke then Destroy the pre-flight key
  "${CURL_MTLS[@]}" -X POST "${KMS_URL}/kmip/2_1" -H "Content-Type: application/json" \
    -d "{\"tag\":\"Revoke\",\"value\":[{\"tag\":\"UniqueIdentifier\",\"type\":\"TextString\",\"value\":\"${PRE_UID}\"},{\"tag\":\"RevocationReason\",\"value\":[{\"tag\":\"RevocationReasonCode\",\"type\":\"Enumeration\",\"value\":\"CessationOfOperation\"}]}]}" >/dev/null
  "${CURL_MTLS[@]}" -X POST "${KMS_URL}/kmip/2_1" -H "Content-Type: application/json" \
    -d "{\"tag\":\"Destroy\",\"value\":[{\"tag\":\"UniqueIdentifier\",\"type\":\"TextString\",\"value\":\"${PRE_UID}\"}]}" >/dev/null
else
  print_error "KMIP pre-flight failed: CreateKeyPair returned no UID. Check KMS logs."
fi

# 5b: Certify with CA key works
PRE_CERT=$("${CURL_MTLS[@]}" -X POST "${KMS_URL}/kmip/2_1" -H "Content-Type: application/json" \
  -d "{\"tag\":\"GetAttributes\",\"value\":[{\"tag\":\"UniqueIdentifier\",\"type\":\"TextString\",\"value\":\"${CA_KEY_UID}\"},{\"tag\":\"AttributeName\",\"type\":\"TextString\",\"value\":\"Link\"}]}" | \
  python3 -c "import sys,json; v=json.load(sys.stdin); print('ok')")
if [[ "${PRE_CERT}" == "ok" ]]; then
  print_success "5b: KMIP GetAttributes on CA key → OK"
else
  print_error "KMIP pre-flight 5b failed: CA key not accessible."
fi

print_success "KMIP API conformance pre-flight passed."

# ── Step 6: Write kmip SPIRE server configs ─────────────────────────────
print_status "Step 6: Write kmip SPIRE server configs for both tenants"
_TMP_DIR=$(mktemp -d /tmp/spire-kmip-full-XXXXXX)

for t in "${TENANTS[@]}"; do
  td="$(tenant_trust_domain "${t}")"
  sid="$(tenant_server_id "${t}")"
  sport="$(tenant_server_port "${t}")"
  hport=$((sport + 1000))

  mkdir -p "/tmp/spire-server-${t}"

  cat >"${_TMP_DIR}/spire-server-${t}.conf" <<SPIRE_CONF
server {
    bind_address = "0.0.0.0"
    bind_port    = "${sport}"
    trust_domain = "${td}"
    data_dir     = "/tmp/spire-server-${t}"
    log_level    = "DEBUG"
    socket_path  = "/tmp/spire-server-${t}/private/api.sock"
    ca_subject = {
        country      = ["FR"]
        organization = ["Cosmian"]
        common_name  = "SPIRE KMIP Test ${t^^}"
    }
    ca_ttl                = "24h"
    default_x509_svid_ttl = "1h"
}
plugins {
    KeyManager "kmip" {
        plugin_data {
            kmip_addr     = "127.0.0.1:5696"
            ca_cert_path = "${CERTS_DIR}/ca.crt"
            server_id    = "${sid}"
            client_cert_path = "${CERTS_DIR}/spire-client.crt"
            client_key_path  = "${CERTS_DIR}/spire-client.key"
        }
    }
    UpstreamAuthority "kmip" {
        plugin_data {
            kmip_addr        = "127.0.0.1:5696"
            ca_cert_path     = "${CERTS_DIR}/ca.crt"
            client_cert_path = "${CERTS_DIR}/spire-client.crt"
            client_key_path  = "${CERTS_DIR}/spire-client.key"
            ca_key_uid       = "${CA_KEY_UID}"
        }
    }
    NodeAttestor "join_token" { plugin_data {} }
    DataStore "sql" {
        plugin_data {
            database_type     = "sqlite3"
            connection_string = "/tmp/spire-server-${t}/datastore.sqlite3"
        }
    }
}
health_checks {
    listener_enabled = true
    bind_address     = "0.0.0.0"
    bind_port        = "${hport}"
    live_path        = "/live"
    ready_path       = "/ready"
}
SPIRE_CONF
  print_info "Written config for tenant '${t}' (port=${sport}, server_id=${sid})"
done

# ── Step 7: Start SPIRE servers (host processes) ──────────────────────────────
print_status "Step 7: Start ${#TENANTS[@]} SPIRE servers (kmip + mTLS)"
for t in "${TENANTS[@]}"; do
  "${SPIRE_SERVER_BIN}" run -config "${_TMP_DIR}/spire-server-${t}.conf" \
    > "/tmp/spire-server-${t}.log" 2>&1 &
  SPIRE_SERVER_PIDS[$t]=$!
  print_info "spire-server-${t} started (PID=${SPIRE_SERVER_PIDS[$t]})"
done

for t in "${TENANTS[@]}"; do
  print_info "Waiting for spire-server-${t} to become healthy…"
  wait_server_healthy "${t}"
  print_success "SPIRE server '${t}' healthy (kmip plugins active)."
done

# ── Step 8: Generate join tokens + start SPIRE agents (Docker) ───────────────
print_status "Step 8: Generate join tokens + start SPIRE agents"

# Write standalone docker-compose for agents + mistral clients (no server containers)
cat >"${_TMP_DIR}/dc.yml" <<DCEOF
volumes:
  spire-agent-socket-a:
  spire-agent-socket-b:

services:
  spire-agent-a:
    image: ghcr.io/spiffe/spire-agent:1.15.2
    profiles: [spire-kmip]
    container_name: spire-agent-a
    user: 0:0
    pid: host
    extra_hosts:
      - host.docker.internal:host-gateway
    volumes:
      - /tmp/spire-agent-config-a/agent.conf:/etc/spire/agent/agent.conf:ro
      - ${CERTS_DIR}/ca.crt:/etc/spire/agent/ca.crt:ro
      - spire-agent-socket-a:/tmp/spire-agent
    command: [-config, /etc/spire/agent/agent.conf]
    healthcheck:
      test: [CMD, /opt/spire/bin/spire-agent, healthcheck, -socketPath, /tmp/spire-agent/public/api.sock]
      interval: 10s
      timeout: 20s
      retries: 12

  spire-agent-b:
    image: ghcr.io/spiffe/spire-agent:1.15.2
    profiles: [spire-kmip]
    container_name: spire-agent-b
    user: 0:0
    pid: host
    extra_hosts:
      - host.docker.internal:host-gateway
    volumes:
      - /tmp/spire-agent-config-b/agent.conf:/etc/spire/agent/agent.conf:ro
      - ${CERTS_DIR}/ca.crt:/etc/spire/agent/ca.crt:ro
      - spire-agent-socket-b:/tmp/spire-agent
    command: [-config, /etc/spire/agent/agent.conf]
    healthcheck:
      test: [CMD, /opt/spire/bin/spire-agent, healthcheck, -socketPath, /tmp/spire-agent/public/api.sock]
      interval: 10s
      timeout: 20s
      retries: 12

  mistral-agent-a1:
    build: ${TEST_DATA}/mistral-client
    profiles: [spire-kmip]
    container_name: mistral-agent-a1
    depends_on:
      spire-agent-a:
        condition: service_healthy
    volumes:
      - spire-agent-socket-a:/tmp/spire-agent:ro
    environment:
      - SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
      - AGENT_ID=mistral-agent-a1
      - TRUST_DOMAIN=cosmian-test-a.local
      - EXPECTED_SPIFFE_PATH=/mistral-agent
      - JWT_AUDIENCE=cosmian-kms

  mistral-agent-a2:
    build: ${TEST_DATA}/mistral-client
    profiles: [spire-kmip]
    container_name: mistral-agent-a2
    depends_on:
      spire-agent-a:
        condition: service_healthy
    volumes:
      - spire-agent-socket-a:/tmp/spire-agent:ro
    environment:
      - SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
      - AGENT_ID=mistral-agent-a2
      - TRUST_DOMAIN=cosmian-test-a.local
      - EXPECTED_SPIFFE_PATH=/mistral-agent
      - JWT_AUDIENCE=cosmian-kms

  mistral-agent-b1:
    build: ${TEST_DATA}/mistral-client
    profiles: [spire-kmip]
    container_name: mistral-agent-b1
    depends_on:
      spire-agent-b:
        condition: service_healthy
    volumes:
      - spire-agent-socket-b:/tmp/spire-agent:ro
    environment:
      - SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
      - AGENT_ID=mistral-agent-b1
      - TRUST_DOMAIN=cosmian-test-b.local
      - EXPECTED_SPIFFE_PATH=/mistral-agent
      - JWT_AUDIENCE=cosmian-kms

  mistral-agent-b2:
    build: ${TEST_DATA}/mistral-client
    profiles: [spire-kmip]
    container_name: mistral-agent-b2
    depends_on:
      spire-agent-b:
        condition: service_healthy
    volumes:
      - spire-agent-socket-b:/tmp/spire-agent:ro
    environment:
      - SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
      - AGENT_ID=mistral-agent-b2
      - TRUST_DOMAIN=cosmian-test-b.local
      - EXPECTED_SPIFFE_PATH=/mistral-agent
      - JWT_AUDIENCE=cosmian-kms
DCEOF
DC="docker compose -f ${_TMP_DIR}/dc.yml"

for t in "${TENANTS[@]}"; do
  td="$(tenant_trust_domain "${t}")"
  sport="$(tenant_server_port "${t}")"
  mkdir -p "/tmp/spire-agent-config-${t}"

  print_info "Generating join token for tenant '${t}'…"
  JOIN_TOKEN=$("${SPIRE_SERVER_BIN}" token generate \
    -spiffeID "spiffe://${td}/spire-agent" \
    -socketPath "/tmp/spire-server-${t}/private/api.sock" |
    awk '/^Token:/{print $2}')
  [[ -z "${JOIN_TOKEN}" ]] && print_error "Failed to generate join token for tenant '${t}'."
  print_info "Tenant '${t}' join token: ${JOIN_TOKEN:0:8}…"

  # Patch agent config: host.docker.internal instead of localhost; fix port to match tenant
  sed -e "s/server_address = \"localhost\"/server_address = \"host.docker.internal\"/" \
      -e "s/server_port    = [0-9]*/server_port    = ${sport}/" \
      -e "s/join_token = \"cosmian-test-join-token-12345\"/join_token = \"${JOIN_TOKEN}\"/" \
    "${TEST_DATA}/config/spire-agent-${t}.conf" >"/tmp/spire-agent-config-${t}/agent.conf"

  ${DC} --profile spire-kmip up -d --force-recreate "spire-agent-${t}"
done

for t in "${TENANTS[@]}"; do
  print_info "Waiting for spire-agent-${t} workload API socket…"
  wait_agent_ready_docker "${t}"
  print_success "SPIRE agent '${t}' ready."
done

