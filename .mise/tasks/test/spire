    -socketPath "/tmp/spire-server-${t}/private/api.sock" \
    -spiffeID "spiffe://${td}/mistral-agent" \
    -parentID "spiffe://${td}/spire-agent" \
    -selector "unix:uid:1000"
  print_success "Tenant '${t}' workload entry registered."
done

