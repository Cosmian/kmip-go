  -d "{\"tag\":\"Locate\",\"value\":[{\"tag\":\"Attributes\",\"value\":[{\"tag\":\"ObjectType\",\"type\":\"Enumeration\",\"value\":\"PrivateKey\"},{\"tag\":\"Name\",\"type\":\"Structure\",\"value\":[{\"tag\":\"NameValue\",\"type\":\"TextString\",\"value\":\"spire-server-id:${SID_A}\"},{\"tag\":\"NameType\",\"type\":\"Enumeration\",\"value\":\"UninterpretedTextString\"}]}]}]}" | \
  python3 -c "import sys,json; v=json.load(sys.stdin)['value']; print(len([x for x in v if x['tag']=='UniqueIdentifier']))")

LOCATE_B=$("${CURL_MTLS[@]}" -X POST "${KMS_URL}/kmip/2_1" -H "Content-Type: application/json" \
